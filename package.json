{
  "name": "routeplan-india",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@routeplan/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@routeplan/web --if-present",
    "qa": "./.hermes-supervisor/qa.sh",
    "qa:external": "./.hermes-supervisor/qa.sh --external",
    "db:push": "cd packages/db && npx supabase db push",
    "db:migrate": "cd packages/db && npx supabase migration new",
    "db:reset": "cd packages/db && npx supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0"
}